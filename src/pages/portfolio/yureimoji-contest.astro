---
import "../../styles/global.css";

const pageTitle = "幽霊文字アイデアコンテスト";
const withBase = (path) => `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${path}`;
const imagePath = withBase("portfolio/yureimoji-contest/poster.png");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="TRPGシナリオ向けに制作した、幽霊文字アイデアコンテストの架空告知ページです。"
    />
    <title>{pageTitle} | tfuna</title>
    <style>
      .contest-shell {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
        padding: 56px 0 72px;
      }

      .contest-header {
        max-width: 760px;
        margin-bottom: 28px;
      }

      .contest-header h1 {
        margin-bottom: 18px;
        font-size: clamp(2.8rem, 8vw, 5rem);
        line-height: 0.98;
      }

      .contest-header p {
        color: var(--muted);
        line-height: 1.9;
      }

      .contest-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.86fr) minmax(280px, 0.54fr);
        gap: 18px;
        align-items: start;
      }

      .poster-card,
      .contest-note {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.8);
        box-shadow: 0 18px 48px rgba(32, 33, 36, 0.08);
      }

      .poster-card {
        padding: 16px;
      }

      .poster-card img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 4px;
      }

      .contest-note {
        padding: 24px;
      }

      .contest-note h2 {
        margin-bottom: 18px;
        font-size: 1.6rem;
      }

      .contest-note dl {
        margin: 0;
      }

      .contest-note dt {
        margin: 20px 0 8px;
        color: var(--accent-strong);
        font-size: 0.9rem;
        font-weight: 800;
      }

      .contest-note dd {
        margin: 0;
        color: var(--muted);
        line-height: 1.85;
      }

      .contest-note ul {
        margin: 10px 0 0;
        padding-left: 1.2rem;
      }

      .contest-note li + li {
        margin-top: 8px;
      }

      @media (max-width: 900px) {
        .contest-layout {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main class="contest-shell">
      <header class="contest-header">
        <p class="eyebrow">Creative Prop</p>
        <h1>{pageTitle}</h1>
        <p>
          TRPGシナリオ向けに制作した架空コンテストの告知ページです。このページだけで内容が確認できるよう、
          外部リンクに頼らず、ポスター画像と要点を同じ画面内にまとめています。
        </p>
      </header>

      <section class="contest-layout" aria-label="幽霊文字アイデアコンテスト告知">
        <article class="poster-card">
          <img src={imagePath} alt="幽霊文字アイデアコンテストのポスター" />
        </article>

        <aside class="contest-note">
          <h2>掲載内容</h2>
          <dl>
            <dt>募集内容</dt>
            <dd>
              幽霊文字に関する生成AIを活用した以下のアイデア
              <ul>
                <li>幽霊文字に関する小説</li>
                <li>幽霊文字に関する動画</li>
                <li>幽霊文字に関する画像</li>
              </ul>
            </dd>

            <dt>賞</dt>
            <dd>最優秀賞 1億円</dd>

            <dt>演出意図</dt>
            <dd>
              応募期間はシナリオ用の違和感として、意図的に判読しづらい処理へ置き換えています。
              プレイヤーに「読めそうで読めない」感触を与えるためのデザインです。
            </dd>

            <dt>用途</dt>
            <dd>
              編集部で受け取る資料、SNSで拡散される画像、運営会社の告知物としてそのまま使える想定です。
            </dd>
          </dl>
        </aside>
      </section>
    </main>
  </body>
</html>
